rules_version = '2';

// Mission Nautilus — règles Firestore
// Les joueurs n'ont pas de compte visible : l'application ouvre une
// authentification anonyme Firebase. Elle sert uniquement à distinguer un
// client autorisé d'un appel totalement anonyme.
//
// Les lectures restent publiques pour permettre au radar et aux spectateurs
// de fonctionner. Toutes les écritures exigent désormais une session
// Firebase authentifiée. Pour une sécurité forte du panneau admin, il faudra
// ensuite remplacer le code admin côté client par des custom claims ou une
// Cloud Function.

service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{teamCode} {
      allow read: if true;
      allow write: if request.auth != null;

      match /matelots/{matelotCode} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /morseSession/{sessionId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Journal de bord partagé de l'équipage (« Activité en direct ») :
      // chaque événement vit dans teams/{equipage}/journal/{id}, lu par
      // tous les matelots de l'équipage en temps réel.
      match /journal/{entryId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /matelots/{matelotCode} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /game/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tout le reste est refusé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
