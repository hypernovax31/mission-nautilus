.nautilus-safe/
apercu-*.wav

__pycache__/
*.pyc

# Journal des requetes du serveur d'apercu (outil de developpement)
.nautilus-requetes.log

# Palier 3 — dépendances de test (jsdom) et fichiers de travail
# La suite principale (tools/tests-*.mjs) tourne SANS rien installer ;
# tools/.deps ne sert qu'aux tests d'interface.
tools/.deps/
# Liste des magasins conservée par l'outil de synchronisation : l'historique
# git suffit, pas besoin de la version précédente dans le dépôt.
data/magasins-fnac.previous.json

# --- Palier 3 « l'artefact du Nautilus » : données RÉELLES, jamais publiées ---
# Le catalogue collecté contient des titres, EAN et SKU réels : GitHub Pages
# publie tout ce qui est commité, il ne doit donc jamais entrer dans le dépôt.
data/catalogue-artefacts.local.json
data/catalogue-artefacts.local.json.*
data/*.local.json
# Cookie de session de l'opérateur (choix du magasin sur fnac.com) : personnel.
*.fnac-cookie
*.cookie
data/cookies-*
